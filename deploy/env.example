# Переменные демо-деплоя FirstYarusOCR на Spark. Скопировать в deploy/.env, chmod 600 (.env в .gitignore).
PORT=8106                    # порт хоста (диапазон демо 8100–8199)
MEM_LIMIT=12g                # Qwen3-VL-2B + Tesseract; память Spark общая с GPU

# --- туннель (профиль public; домен — при сборке платформы) ---
TUNA_SUBDOMAIN=
TUNA_TOKEN=
TUNA_EXTRA_ARGS=             # у API нет авторизации: при публикации --basic-auth=login:pass
